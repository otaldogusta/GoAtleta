{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-atleta:engineer:ui-review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_reviewed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "enum": [
        "PASS",
        "PASS_WITH_FINDINGS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "visual": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          }
        },
        "required": [
          "file",
          "issue",
          "impact",
          "recommendation",
          "evidence",
          "severity"
        ]
      }
    },
    "ux": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          }
        },
        "required": [
          "file",
          "issue",
          "impact",
          "recommendation",
          "evidence",
          "severity"
        ]
      }
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          }
        },
        "required": [
          "file",
          "issue",
          "impact",
          "recommendation",
          "evidence",
          "severity"
        ]
      }
    },
    "motion": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },

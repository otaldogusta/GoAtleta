            ]
          }
        },
        "required": [
          "file",
          "issue",
          "impact",
          "recommendation",
          "evidence",
          "severity"
        ]
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",

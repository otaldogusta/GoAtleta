{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-atleta:engineer:specialist-result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "implementation",
        "test-review",
        "security-review",
        "ui-ux-motion-review"
      ]
    },
    "subagent_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "PASS_WITH_FINDINGS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          }
        },
        "required": [
          "file",
          "issue",
          "impact",
          "recommendation",
          "evidence",
          "severity"
        ]
      }
    }
  },
  "required": [
    "role",
    "subagent_id",
    "result",
    "summary",
    "evidence",
    "findings"
  ]
}

# Recommended: copy to .env.local
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# WhatsApp Default Message Toggle
# Set to "true" or "default" to enable default messages in WhatsApp links
# Set to "false" or "disabled" to send empty message texts
EXPO_PUBLIC_WHATSAPP_DEFAULT_TEXT=true
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
EXPO_PUBLIC_NAV_V2=1

# Supabase Edge Function secrets for the read-only Asaas connector.
# Configure these with `supabase secrets set`; never expose them as EXPO_PUBLIC_*.
PAYMENT_PROVIDER_ENCRYPTION_KEY=generate-a-random-secret-with-at-least-32-characters
# Optional overrides. Hosted Edge Functions derive the URL from SUPABASE_URL
# and use the connected coordinator's e-mail when these values are omitted.
ASAAS_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/asaas-webhook
ASAAS_WEBHOOK_ALERT_EMAIL=financeiro@example.com
